{
  "name": "@cozy/comfy",
  "version": "0.1.0",
  "private": false,
  "description": "cozy design system: tokens, CSS theme and logos",
  "type": "module",
  "exports": {
    "./css/*": "./css/*",
    "./tokens": "./tokens/index.ts",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*",
    "./map": "./map/style.ts",
    "./docs/*": "./docs/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && git diff --exit-code -- tokens css || (echo \"generated files are stale: run pnpm build\" && exit 1)"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "culori": "^4.0.2",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cozy-nyc/comfy.git"
  },
  "files": [
    "assets",
    "css",
    "map",
    "tokens",
    "scripts",
    "README.md",
    "LICENSE",
    "docs"
  ]
}
