{
  "$description": "Hand-picked inputs. scripts/build.mjs turns these into primitives.json, semantic.*.json and css/cozy.css. Edit here (and in Figma), never the generated files.",
  "hues": {
    "$description": "Base colors from the cozy Figma guide. Each becomes a ramp with steps 5..99 (higher = lighter), keeping the base hue and chroma. Optional chroma/hue override the base.",
    "pink": {
      "hex": "#F792BE",
      "label": "cozy pink"
    },
    "hot": {
      "hex": "#D92D6B",
      "label": "cozy hot"
    },
    "peach": {
      "hex": "#FFB9A6",
      "label": "cozy peach"
    },
    "blue": {
      "hex": "#58A2C1",
      "label": "cozy blue"
    },
    "deep": {
      "hex": "#2B6484",
      "label": "cozy deep"
    },
    "ice": {
      "hex": "#76E3DD",
      "label": "cozy ice"
    },
    "neutral": {
      "hex": "#494949",
      "chroma": 0.006,
      "hue": 60,
      "label": "cozy black, warmed slightly so the ramp runs toward cozy white #FFFDFA"
    }
  },
  "ramp": {
    "steps": [
      5,
      10,
      15,
      20,
      25,
      30,
      35,
      40,
      50,
      60,
      70,
      80,
      90,
      95,
      98,
      99
    ]
  },
  "roles": {
    "$description": "Which ramp each semantic family draws from.",
    "primary": "hot",
    "secondary": "blue",
    "tertiary": "neutral",
    "accent": "pink",
    "success": "ice",
    "failure": "hot",
    "warning": "peach",
    "info": "blue"
  },
  "fonts": {
    "display": {
      "family": "Dosis",
      "fallback": "sans-serif",
      "use": "Display. Lowercase, extra bold.",
      "google": "Dosis:wght@200;600;800"
    },
    "heading": {
      "family": "Montserrat Alternates",
      "fallback": "sans-serif",
      "use": "Headers, labels, interactives.",
      "google": "Montserrat+Alternates:wght@300;700;800"
    },
    "body": {
      "family": "Open Sans",
      "fallback": "sans-serif",
      "use": "Body and paragraphs.",
      "google": "Open+Sans:ital,wght@0,300;0,400;0,700;1,400;1,700"
    },
    "data": {
      "family": "Space Mono",
      "fallback": "monospace",
      "use": "Numbers, times, inputs. (Proposed; the Figma guide has no data face yet.)",
      "google": "Space+Mono:wght@400;700"
    }
  },
  "spacing": {
    "$description": "8-point scale. Key = multiplier of 8px.",
    "0.25": 2,
    "0.5": 4,
    "1": 8,
    "2": 16,
    "3": 24,
    "4": 32,
    "5": 40,
    "6": 48,
    "7": 56,
    "8": 64,
    "9": 72,
    "10": 80,
    "11": 88,
    "12": 96
  },
  "radius": {
    "none": 2,
    "xs": 8,
    "sm": 16,
    "base": 24,
    "lg": 48,
    "xl": 96,
    "full": 9999
  },
  "breakpoints": {
    "sm": 480,
    "md": 800,
    "lg": 1200,
    "xl": 1600
  },
  "layout": {
    "columns": 12,
    "gutter": 24,
    "minDesktopWidth": 800
  },
  "shadows": {
    "$description": "Soft and low-contrast. Color is neutral-5 at the given alpha.",
    "sm": "0 1px 2px rgba(20,16,18,0.08), 0 1px 1px rgba(20,16,18,0.04)",
    "base": "0 4px 12px rgba(20,16,18,0.10), 0 1px 2px rgba(20,16,18,0.06)",
    "lg": "0 12px 32px rgba(20,16,18,0.14), 0 2px 4px rgba(20,16,18,0.06)"
  },
  "blurs": {
    "sm": 4,
    "base": 12,
    "lg": 32
  },
  "palette": {
    "$description": "The original named colors from the Figma guide. Kept verbatim as --cozy-* and the palette export.",
    "white": "#FFFDFA",
    "grey": "#C4C4C4",
    "smoke": "#696D73",
    "black": "#494949",
    "pink": "#F792BE",
    "peach": "#FFB9A6",
    "hot": "#D92D6B",
    "blue": "#58A2C1",
    "deep": "#2B6484",
    "ice": "#76E3DD"
  },
  "map": {
    "$description": "Subway-map style colors used by map/style.ts: flat NYC after the MTA/Vignelli diagram.",
    "water": {
      "$value": "#C5D1D7",
      "$description": "flat grey-blue; everything outside the five boroughs is this color"
    },
    "land": {
      "$value": "#FFFDFA",
      "$description": "cozy white"
    },
    "road": {
      "$value": "#ECE8E3",
      "$description": "streets, faint"
    },
    "park": {
      "$value": "#E3EEDC",
      "$description": "pale green"
    },
    "label": {
      "$value": "#8E8B88"
    },
    "station": {
      "$value": "#FFFFFF",
      "$description": "station dots"
    }
  }
}
